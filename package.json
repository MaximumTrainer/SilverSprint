{
  "name": "silversprint-api",
  "version": "1.0.0",
  "description": "Masters Track & Field Speed Development Engine",
  "license": "MIT",
  "main": "src/index.ts",
  "scripts": {
    "dev": "vite",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "scan:secrets": "node scripts/scan-secrets.mjs --all",
    "verify": "npm run scan:secrets && npm run lint && npm run typecheck && npm run test:coverage",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "date-fns": "^3.3.1",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
